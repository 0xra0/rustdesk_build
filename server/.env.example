# Copy this file to .env and fill in the values before running docker compose.

# ── Tailscale ────────────────────────────────────────────────────────────────

# Auth key from https://login.tailscale.com/admin/settings/keys
# Use a *reusable* key so the container can re-authenticate after restarts,
# or pre-authorize the node and omit this after the first run.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Hostname shown in your tailnet (and used for MagicDNS).
TS_HOSTNAME=rustdesk
